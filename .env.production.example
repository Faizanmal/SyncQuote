# SyncQuote VPS production — copy to .env.production and fill in secrets
# Domain: syncquote.faizanmalik.me

# --- Domain ---
DOMAIN=syncquote.faizanmalik.me
FRONTEND_URL=https://syncquote.faizanmalik.me
ALLOWED_ORIGINS=https://syncquote.faizanmalik.me

# Baked into the Next.js client at build time
NEXT_PUBLIC_API_URL=https://syncquote.faizanmalik.me/api/v1
NEXT_PUBLIC_WS_URL=https://syncquote.faizanmalik.me
NEXT_PUBLIC_SOCKET_URL=https://syncquote.faizanmalik.me

# --- Database (Docker internal) ---
POSTGRES_DB=syncquote
POSTGRES_USER=syncquote
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Auth (REQUIRED — app refuses default-secret) ---
JWT_ACCESS_SECRET=CHANGE_ME_long_random_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Stripe (test or live) ---
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=price_...

# Stripe Dashboard webhook URL:
#   https://syncquote.faizanmalik.me/api/v1/webhooks/stripe

# --- Email (optional — send/notify skip cleanly if unset) ---
SENDGRID_API_KEY=
EMAIL_FROM=noreply@faizanmalik.me
EMAIL_FROM_NAME=SyncQuote

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://syncquote.faizanmalik.me/api/v1/auth/google/callback

# --- Observability (optional) ---
SENTRY_DSN=

# --- Rate limits ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
